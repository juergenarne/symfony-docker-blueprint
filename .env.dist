# Template - copy to .env and fill in real values: cp .env.dist .env
# .env is NOT in git (it holds the passwords). On a running server the values must match
# the existing database - MariaDB only reads MYSQL_* when its data directory is empty.

# General
APP_NAME=symfony
APP_ENV=prod

# Versions & Ports
APACHE_PORT=8085
MYSQL_PORT=3305
MARIADB_VERSION=11.4

# Paths
DOCKER_CONFIG=docker
APACHE_HTDOCS=symfony
MARIADB_LOCAL_DIR=./docker/mariadb
MARIADB_DATA_DIR=/data
MARIADB_CONF_DIR=/conf.d
MARIADB_ETC_DIR=/

# Database
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=symfony
MYSQL_USER=symfony
MYSQL_PASSWORD=CHANGE_ME

# Deploy
DEPLOY_BRANCH=master
